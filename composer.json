{
    "name": "sd/symfony-tetris",
    "license": "MIT",
    "type": "project",
    "description": "Symfony Tetris",
    "require": {
        "php": ">=8.4.1",
        "ext-pcntl": "*",
        "ext-sockets": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.5",
        "sd/symfony-console-helper": "dev-master",
        "symfony/console": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/scottdriscoll/symfony-console-helper"
        }
    ],
    "suggest": {
        "ext-pdo_sqlite": "Required to run the configured SQLite leaderboard database and Doctrine migrations."
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
